---
layout: null
---
[ 
{% for post in site.posts %} 
{ 
"title"    : {% if post.title != "" %}{{ post.title | strip_html | jsonify }}{% else %}{{ post.excerpt | strip_html | strip | jsonify }}{%endif%}, 
"desc"     : {% if post.title != "" %}{{ post.title | strip_html | jsonify }}{% else %}{{ post.excerpt | strip_html | strip | jsonify }}{%endif%}, 
"category" : {{ post.tags | join: ', ' | jsonify }}, 
"url"      : {{ post.url | relative_url | jsonify }}, 
"date"     : {{ post.date | date: "%B %e, %Y" | default: "January 1, 1970" | jsonify }} 
}, 
{% endfor %} 
{% for page in site.html_pages %}{% if page.title != "{title}" and page.title != "404 - Page not found" %} 
{ 
"title"    : {% if page.title != "" %}{{ page.title | strip_html | jsonify }}{% else %}{{ page.excerpt | strip_html | strip | jsonify }}{% endif %}, 
"desc"     : {% if page.title != "" %}{{ page.title | strip_html | jsonify }}{% else %}{{ page.excerpt | strip_html | strip | jsonify }}{% endif %}, 
"category" : {% if page.tags %}{{ page.tags | join: ', ' | jsonify }}{% else %}"page"{% endif %}, 
"url"      : {{ page.url | relative_url | jsonify }}, 
"date"     : {{ page.date | date: '%B %e, %Y' | default: "January 1, 1970" | jsonify }} 
}{% unless forloop.last %},{% endunless %} 
{% endif %}{% endfor %} 
]
